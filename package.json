{
  "name": "agentpay-router",
  "private": true,
  "version": "0.1.0",
  "description": "The authorization and trust layer between autonomous software and money.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "npm run dev -w @agentpay/api",
    "db:generate": "npm run generate -w @agentpay/db",
    "db:push": "npm run push -w @agentpay/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  }
}
