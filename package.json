{
  "name": "waysafe",
  "private": true,
  "version": "0.1.0",
  "description": "Waysafe: the system of record for delegated financial authority.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "npm run dev -w @waysafe/api",
    "dev:worker": "npm run dev:worker -w @waysafe/api",
    "quickstart": "tsx --env-file-if-exists=.env examples/quickstart.ts",
    "demo": "tsx --env-file-if-exists=.env examples/demo.ts",
    "demo:merchant": "tsx --env-file-if-exists=.env examples/demo-merchant.ts",
    "demo:seed": "npm run demo:seed -w @waysafe/api",
    "dev:dashboard": "npm run dev -w @waysafe/dashboard",
    "db:generate": "npm run generate -w @waysafe/db",
    "db:push": "npm run push -w @waysafe/db",
    "db:constraints": "npm run constraints -w @waysafe/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  }
}
