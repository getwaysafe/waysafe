# The Waysafe API this dashboard reads from.
WAYSAFE_API_BASE_URL="http://localhost:3001"

# Encrypts the session cookie (D-23 / OQ-4). Generate with:
#   openssl rand -base64 32
WAYSAFE_DASHBOARD_SESSION_SECRET=""

# --- /demo (D-42) ---
# A real org Bearer credential for org_demo -- from `npm run demo:seed -w
# @waysafe/api`. The /demo route is not behind dashboard login; it's its
# own standalone recordable page, authenticated to the Waysafe API with
# this one fixed credential rather than a session cookie.
WAYSAFE_DEMO_ORG_API_KEY=""
# The x402 merchant script (examples/demo-merchant.ts).
WAYSAFE_DEMO_MERCHANT_URL="http://127.0.0.1:4402"
# The agent's own runtime key for the demo -- secp256k1, 0x-prefixed hex.
# Reuses the same fixture session key x402.bypass.test.ts already
# establishes as one of the live Safe's two owners; never Waysafe's key,
# and never sent to the Waysafe API -- only its signatures are (see
# apps/dashboard/src/lib/demo/agent-runtime.ts).
WAYSAFE_DEMO_AGENT_SESSION_KEY=""
# Read-only; used only to fetch nonces/build unsigned transactions locally.
POLYGON_AMOY_RPC_URL=""
