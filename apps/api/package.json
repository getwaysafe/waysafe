{
  "name": "@waysafe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "compile": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "compile:record": "tsx --env-file-if-exists=../../.env src/record-fixture.ts",
    "keygen": "tsx src/keygen.ts",
    "deploy-x402-safe": "tsx --env-file-if-exists=../../.env src/enforcement/deploy-x402-safe.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@safe-global/protocol-kit": "^8.0.7",
    "@simplewebauthn/server": "^13.3.2",
    "@waysafe/core": "*",
    "fastify": "^5.2.0",
    "stripe": "^22.5.0",
    "viem": "^2.56.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cbor-x": "^1.6.6"
  }
}
