{
  "name": "@agentpay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "compile": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "compile:record": "tsx --env-file-if-exists=../../.env src/record-fixture.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentpay/core": "*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  }
}
