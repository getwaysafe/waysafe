# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/waysafe?schema=public"

# --- Intent compiler (LLM is used ONLY to compile natural language into policy) ---
ANTHROPIC_API_KEY=""
WAYSAFE_COMPILER_MODEL="claude-sonnet-4-5"
# Set to "fixture" to replay recorded compiler output (no network, used in tests)
WAYSAFE_COMPILER="anthropic"

# --- Payments (Week 4) ---
# A RESTRICTED test-mode key -- Payment Intents: Write, nothing else granted.
STRIPE_SECRET_KEY="sk_test_..."
# Verifies webhook signatures. Not tied to STRIPE_SECRET_KEY or to any live
# webhook endpoint in the Stripe dashboard -- constructEvent/
# generateTestHeaderString are local HMAC operations, so any value here is
# fine for dev/test. Replace with the real one from the dashboard only once
# a live webhook endpoint is actually configured to receive from Stripe.
STRIPE_WEBHOOK_SECRET="whsec_dev_placeholder"

# --- Enforcement: Stripe Issuing (D-32/D-33) ---
# A RESTRICTED test-mode key -- Issuing: Cardholders/Cards write, Issuing:
# Authorizations read, nothing else. Deliberately separate from
# STRIPE_SECRET_KEY: this key provisions cards, the other moves payments; a
# key that could do both is a bigger blast radius than either alone needs to
# be. Not read by the server at request time -- only by whatever provisions
# cards for mandates (see provisionCardForMandate in
# apps/api/src/enforcement/stripe-issuing.ts) and by its live test suite.
STRIPE_ISSUING_SECRET_KEY="sk_test_..."
# Verifies the issuing_authorization.request webhook's signature. A
# genuinely separate secret from STRIPE_WEBHOOK_SECRET -- Stripe issues one
# signing secret per configured webhook endpoint, and /v1/webhooks/stripe
# and /v1/enforcement/stripe-issuing are two different endpoints. Same local-
# HMAC-only caveat as STRIPE_WEBHOOK_SECRET: any value is fine for dev/test.
STRIPE_ISSUING_WEBHOOK_SECRET="whsec_dev_placeholder"
# The v2 Money Management financial account Issuing cards are created
# against (D-37). This account has no legacy Issuing balance -- card
# creation 400s without one, and Stripe's own field for it is
# `financial_account_v2`, not the `financial_account` stripe-node's shipped
# types call it (see provisionCardForMandate). Find or create one with
# `stripe get /v2/money_management/financial_accounts -v "<version>.preview"`
# (Money Management is preview-gated: only a `.preview`-suffixed
# Stripe-Version can see this path) or the Dashboard. provisionCardForMandate
# throws loudly at call time if this is unset -- never silently falls back to
# some other balance, because there isn't one.
STRIPE_ISSUING_FINANCIAL_ACCOUNT="fa_test_..."

# --- Evidence signing (Week 3, wired Week 6 -- D-26/OQ-8) ---
# Ed25519 private key, base64 PKCS8. Generate: npm run keygen -w @waysafe/api
WAYSAFE_EVIDENCE_SIGNING_KEY=""

# --- WebAuthn (Week 3) ---
# Passkeys are bound to this domain. Changing it invalidates every registered passkey.
# Production RP ID is dashboard.waysafe.ai (D-29) -- localhost here is for
# local development only; every credential registered against it is disposable.
WAYSAFE_RP_ID="localhost"
WAYSAFE_RP_ORIGIN="http://localhost:3000"

# --- API ---
PORT="3001"
